//@version=6
// ============================================================================
//  INDICATEUR 1/2 v2 — « Boussole de Tendance »  (à lire en DAILY)
//  Rôle : donner la DIRECTION et un FEU vert / rouge / gris.
//    - Vert  = tendance haussière + marché en mouvement -> cherche un ACHAT
//    - Rouge = tendance baissière + marché en mouvement -> cherche une VENTE
//    - Gris  = marché plat (range) -> NE PAS TRADER cette paire
//
//  NOUVEAU en v2 (vs indicateur_1_boussole_tendance.pine, conservé) :
//    1. ALERTES au changement de régime (vert/rouge/gris) → plus besoin de
//       vérifier le graphique tous les jours, ton téléphone te prévient.
//    2. Distance à l'EMA200 en multiples d'ATR dans le tableau : si le prix
//       est très loin de sa moyenne (> 3 ATR), la tendance est « étirée » —
//       acheter là est statistiquement plus risqué (retour de bâton fréquent).
//    3. Le régime affiché/alerté est celui de la DERNIÈRE BARRE CLÔTURÉE
//       (pas de clignotement en cours de journée).
// ============================================================================
indicator("Boussole de Tendance v2 — Forex Swing", overlay = true)

// ----------------------------- Entrées --------------------------------------
emaFastLen = input.int(20,  "EMA rapide",  minval = 1, group = "Moyennes mobiles")
emaMidLen  = input.int(50,  "EMA moyenne", minval = 1, group = "Moyennes mobiles")
emaSlowLen = input.int(200, "EMA lente",   minval = 1, group = "Moyennes mobiles")
adxLen     = input.int(14,  "Longueur ADX",            minval = 1, group = "Filtre de régime")
adxThr     = input.float(25, "Seuil ADX (= tendance)", minval = 1, group = "Filtre de régime")
atrLen     = input.int(14,  "Longueur ATR (étirement)", minval = 1, group = "Filtre de régime")
stretchThr = input.float(3.0, "Seuil d'étirement (× ATR vs EMA200)", minval = 0.5,
                         group = "Filtre de régime",
                         tooltip = "Au-delà : tendance étirée, prudence sur les nouvelles entrées.")
showBg     = input.bool(true, "Colorer le fond", group = "Affichage")

// ----------------------------- Calculs --------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
atrVal  = ta.atr(atrLen)

[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)

bull     = close > emaSlow and emaFast > emaMid      // tendance haussière
bear     = close < emaSlow and emaFast < emaMid      // tendance baissière
trending = adx > adxThr                              // marché en mouvement

// Régime : +1 achat possible / −1 vente possible / 0 ne pas trader
regime = bull and trending ? 1 : bear and trending ? -1 : 0

// Distance à l'EMA200 en ATR (mesure d'« étirement » de la tendance)
distAtr   = atrVal > 0 ? (close - emaSlow) / atrVal : na
stretched = not na(distAtr) and math.abs(distAtr) > stretchThr

// ----------------------------- Tracés ---------------------------------------
plot(emaFast, "EMA 20",  color = color.new(color.aqua,   0), linewidth = 1)
plot(emaMid,  "EMA 50",  color = color.new(color.orange, 0), linewidth = 2)
plot(emaSlow, "EMA 200", color = color.new(color.gray,   0), linewidth = 3)

bgCol = regime == 1 ? color.new(color.green, 88) :
        regime == -1 ? color.new(color.red, 88) : na
bgcolor(showBg ? bgCol : na, title = "Fond régime")

// ----------------------------- Alertes --------------------------------------
// Changement de régime sur barre CLÔTURÉE uniquement (pas de faux signaux
// en cours de journée : le régime du jour n'est connu qu'à la clôture).
regimeChanged = barstate.isconfirmed and regime != regime[1]
toBull    = regimeChanged and regime == 1
toBear    = regimeChanged and regime == -1
toNeutral = regimeChanged and regime == 0

alertcondition(toBull,    "Régime → HAUSSIER",  "Boussole : passe au VERT — chercher des ACHATS")
alertcondition(toBear,    "Régime → BAISSIER",  "Boussole : passe au ROUGE — chercher des VENTES")
alertcondition(toNeutral, "Régime → NEUTRE",    "Boussole : passe au GRIS — ne plus trader cette paire")

if regimeChanged
    txt = regime == 1 ? "VERT (achats)" : regime == -1 ? "ROUGE (ventes)" : "GRIS (ne pas trader)"
    alert("Boussole " + syminfo.ticker + " : régime → " + txt, alert.freq_once_per_bar_close)

// ----------------------------- Tableau --------------------------------------
var table t = table.new(position.top_right, 2, 4, border_width = 1)

tendTxt = bull ? "HAUSSIÈRE" : bear ? "BAISSIÈRE" : "NEUTRE"
tendCol = bull ? color.green : bear ? color.red   : color.gray
regTxt  = trending ? "TREND" : "RANGE"
regCol  = trending ? color.green : color.gray
actTxt  = regime == 1 ? "✅ Cherche un ACHAT" :
          regime == -1 ? "✅ Cherche une VENTE" : "⛔ Ne pas trader"
actCol  = regime != 0 ? color.green : color.red
distTxt = na(distAtr) ? "n/a" : str.tostring(distAtr, "#.0") + " ATR" + (stretched ? "  ⚠️ étiré" : "")
distCol = stretched ? color.orange : color.gray

if barstate.islast
    table.cell(t, 0, 0, "Tendance", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(t, 1, 0, tendTxt,    text_color = color.white, bgcolor = color.new(tendCol, 30))
    table.cell(t, 0, 1, "ADX",      text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(t, 1, 1, str.tostring(adx, "#.0") + "  " + regTxt, text_color = color.white, bgcolor = color.new(regCol, 30))
    table.cell(t, 0, 2, "Dist. EMA200", text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(t, 1, 2, distTxt,    text_color = color.white, bgcolor = color.new(distCol, 30))
    table.cell(t, 0, 3, "Action",   text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(t, 1, 3, actTxt,     text_color = color.white, bgcolor = color.new(actCol, 20))
